# NOVAIQ auto-poster — environment variables
# Copy to .env for local use, or register these as Cloud Agent Secrets.

# OpenAI (required for real article + image generation)
OPENAI_API_KEY=

# Text + image models (can be changed anytime)
NOVAIQ_TEXT_MODEL=gpt-5.6-luna
NOVAIQ_IMAGE_MODEL=gpt-image-2
# Cost-effective defaults for eyecatch images
NOVAIQ_IMAGE_SIZE=1536x1024
NOVAIQ_IMAGE_QUALITY=low

# WordPress REST API (Application Password auth)
# WP_URL example: https://example.com  (no trailing /wp-json)
WP_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# NOVAIQ Connector (recommended for ConoHa WING etc. that strip Authorization).
# Install wordpress/novaiq-connector.php into wp-content/mu-plugins/ and set the
# same secret value here as in the plugin file.
NOVAIQ_API_KEY=

# Optional: contact email for OpenAlex "polite pool" (recommended, not required)
OPENALEX_MAILTO=
# Optional: NCBI API key raises PubMed rate limits (not required)
NCBI_API_KEY=
