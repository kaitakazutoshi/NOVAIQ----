# NOVAIQ auto-poster — environment variables
# Copy to .env for local use, or register these as Cloud Agent Secrets.

# OpenAI (required for real article + image generation)
OPENAI_API_KEY=

# Text + image models (can be changed anytime)
NOVAIQ_TEXT_MODEL=gpt-4o
NOVAIQ_IMAGE_MODEL=gpt-image-1

# WordPress REST API (required for draft posting)
# WP_URL example: https://example.com  (no trailing /wp-json)
WP_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# Optional: contact email for OpenAlex "polite pool" (recommended, not required)
OPENALEX_MAILTO=
# Optional: NCBI API key raises PubMed rate limits (not required)
NCBI_API_KEY=
